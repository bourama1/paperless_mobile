# Shared API key sent to the backend on every request (header X-API-Key)
# and on the Socket.IO handshake. Must match the backend's API_KEY exactly.
#
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time,
# so this value ships inside the app binary — it stops casual/network-level
# access, not someone who decompiles the APK. Rotating it means updating
# both this file and the backend's .env, then rebuilding the app.
EXPO_PUBLIC_API_KEY=

# Set to "true" once the backend has a real TLS certificate and you've
# copied it into certs/backend-ca.pem — leave unset/false to deploy over
# plain HTTP in the meantime. See certs/README.md for the full two-phase
# deploy flow (insecure now, switch to HTTPS later without other code
# changes). Requires a full rebuild to take effect either way.
EXPO_PUBLIC_BACKEND_USE_HTTPS=
