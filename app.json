{
    "expo": {
        "name": "paperless_mobile",
        "slug": "paperless_mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "scheme": "paperless-mobile",
        "newArchEnabled": false,
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "package": "com.bourama1.paperless_mobile",
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "output": "single"
        },
        "plugins": [
            "expo-router",
            "expo-asset",
            "expo-font",
            [
                "./plugins/withBackendCertPinning",
                {
                    "certPath": "./certs/backend-ca.pem",
                    "hostnames": ["10.110.10.6"]
                }
            ],
            "./plugins/withReleaseSigning"
        ],
        "extra": {
            "router": {},
            "eas": {
                "projectId": "2293b382-511d-4b65-9edb-06a5f190f57b"
            }
        },
        "owner": "bourama1"
    }
}
